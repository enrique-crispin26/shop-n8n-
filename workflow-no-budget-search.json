      {
        "parameters": {
          "jsCode": "// =====================================================\n// 1. PRODUCTOS QUE LLEGAN DESDE GOOGLE SHEETS\n// =====================================================\n\nconst productosSheets = $input.all().map(item => item.json);\n\n\n// =====================================================\n// 2. CONSULTA DEL CLIENTE DESDE \"Editar campos\"\n// =====================================================\n\nconst solicitud = $('SolicitudCliente').first().json;\n\nconst cliente = String(\n  solicitud.cliente ?? ''\n).trim();\n\nconst productoBuscado = String(\n  solicitud.producto ?? ''\n)\n  .trim()\n  .toLowerCase();\n\nconst presupuesto = Number(\n  solicitud.presupuesto ?? 0\n);\n\n\n// =====================================================\n// 3. NORMALIZAR INVENTARIO\n// =====================================================\n\nconst inventario = productosSheets.map(producto => ({\n  identificacion:\n    producto['IDENTIFICACIÓN'] ??\n    producto.ID ??\n    null,\n\n  marca: String(\n    producto.Marca ?? ''\n  ).trim(),\n\n  modelo: String(\n    producto.Modelo ?? ''\n  ).trim(),\n\n  precio: Number(\n    producto.Precio ?? 0\n  ),\n\n  existencias: Number(\n    producto.Stock ?? producto.Existencias ?? 0\n  )\n}));\n\n\n// =====================================================\n// 4. PRODUCTOS VENDIBLES\n// =====================================================\n\nconst tienePresupuesto = presupuesto > 0;\n\nconst disponibles = inventario.filter(producto =>\n  producto.precio > 0 &&\n  producto.existencias > 0 &&\n  (!tienePresupuesto || producto.precio <= presupuesto)\n);\n\n\n// =====================================================\n// 5. PRODUCTOS QUE COINCIDEN CON LO BUSCADO\n// =====================================================\n\nconst coincidencias = disponibles\n  .filter(producto => {\n\n    const marca =\n      producto.marca.toLowerCase();\n\n    const modelo =\n      producto.modelo.toLowerCase();\n\n    return (\n      marca.includes(productoBuscado) ||\n      modelo.includes(productoBuscado)\n    );\n\n  })\n  .sort((a, b) => b.precio - a.precio);\n\n\n// =====================================================\n// 6. ALTERNATIVAS\n// =====================================================\n\nconst alternativas = disponibles\n  .filter(producto => {\n\n    const marca =\n      producto.marca.toLowerCase();\n\n    const modelo =\n      producto.modelo.toLowerCase();\n\n    const coincide =\n      marca.includes(productoBuscado) ||\n      modelo.includes(productoBuscado);\n\n    return !coincide;\n\n  })\n  .sort((a, b) => b.precio - a.precio);\n\n\n// =====================================================\n// 7. LIMITAR RESULTADOS\n// =====================================================\n\nconst productosEncontrados =\n  coincidencias.slice(0, 3);\n\nconst productosAlternativos =\n  alternativas.slice(0, 3);\n\n\n// =====================================================\n// 8. DETERMINAR ESTADO\n// =====================================================\n\nlet estado;\n\nif (productosEncontrados.length > 0) {\n\n  estado = 'encontrado';\n\n} else if (productosAlternativos.length > 0) {\n\n  estado = 'solo_alternativas';\n\n} else {\n\n  estado = 'sin_resultados';\n\n}\n\n\n// =====================================================\n// 9. SALIDA\n// =====================================================\n\nreturn [\n  {\n    json: {\n      cliente,\n      producto_buscado: productoBuscado,\n      presupuesto,\n      estado,\n\n      cantidad_encontrada:\n        productosEncontrados.length,\n\n      productos:\n        productosEncontrados,\n\n      cantidad_alternativas:\n        productosAlternativos.length,\n\n      alternativas:\n        productosAlternativos\n    }\n  }\n];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          560,
          1008
        ],
